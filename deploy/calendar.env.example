# Environment of the `calendar` service without Docker (deploy/calendar.service
# reads it from /etc/calendar.env). Every variable the server reads is here;
# the README says the same in more words. No secret belongs in this file: the
# server has none.

# --- Listening -----------------------------------------------------------
# Only the reverse proxy on this host talks to the server.
HOST=127.0.0.1
PORT=8787

# --- The address of the app --------------------------------------------------
# The DAV proxy answers only requests whose Host is the host of VITE_APP_URL,
# an IP address or a local name, so that a page that points its own name at
# this server cannot use it.
VITE_APP_URL=https://calendar.example.com
# Other names this server is reached by (comma separated, *.example.com allowed):
# CALENDAR_PUBLIC_HOSTS=www.calendar.example.com

# Links the app shows (empty = not shown). The server puts the ones set here
# into the page it serves, ahead of any the bundle was built with:
# VITE_PRIVACY_URL=https://example.com/privacy
# VITE_TERMS_URL=https://example.com/terms
# VITE_CONTACT_URL=mailto:admin@example.com

# --- Who the client is ------------------------------------------------------
# The number of proxies that each add an address to X-Forwarded-For between
# the browser and this server. The DAV proxy's request budgets are per client
# address; too low a number puts every visitor into one budget, too high a
# number lets a client pick its own address and with it a fresh budget.
#
#   browser -> CDN -> nginx/Caddy on this host -> server   = 2
#   browser -> nginx/Caddy on this host -> server          = 1
#   browser -> server                                      = 0
CALENDAR_TRUST_PROXY=1

# --- The DAV proxy ------------------------------------------------------------
# The app relays CalDAV for browsers, so it sees the passwords of those
# accounts in transit. Either name the servers it may reach...
CALENDAR_PROXY_ALLOW=dav.example.com
# ...or switch it off (CalDAV in the browser then works only with servers
# that send CORS headers; the Android app never uses it):
# CALENDAR_PROXY_DISABLED=true
# Without a list the proxy reaches no host; "true" would let it reach any
# public host for anybody. Never on a server other people use.
# CALENDAR_PROXY_OPEN=false
# The names above must resolve to public addresses. Dotted names of servers
# on your own network go here instead (IP addresses, names without a dot and
# .local/.lan/.internal/.home.arpa names may stay in CALENDAR_PROXY_ALLOW):
# CALENDAR_PROXY_PRIVATE_HOSTS=dav.home.example
# Loopback and LAN addresses stay closed; only for a server on a network you trust:
CALENDAR_PROXY_ALLOW_PRIVATE=false
# Plain http:// with a password goes only to servers on a private network, so
# no password crosses the internet in clear; "true" allows it to public servers
# too. Without a password (a public feed) http:// goes anywhere https:// would.
# CALENDAR_PROXY_ALLOW_HTTP=false

# Request budget per client address (IPv6: per /64). Requests over a limit
# wait up to 30 s for their turn, then get 429/503. 0 = unlimited.
CALENDAR_PROXY_RATE=600
CALENDAR_PROXY_BURST=300
CALENDAR_PROXY_CLIENT_CONCURRENCY=6
# Each request in flight may hold a body of up to 10 MiB; all of them together
# hold at most 128 MiB (one client a quarter), which fits MemoryMax=512M.
CALENDAR_PROXY_CONCURRENCY=32
# Answers 401 (a wrong password) one client may get in 10 minutes; past it its
# requests with a password get 429 for a while. 0 = unlimited.
CALENDAR_PROXY_AUTH_FAILURES=20
# One line per request (client, method, host, status, duration; never paths
# or credentials) goes to the journal. "false" silences it.
CALENDAR_PROXY_LOG=true

# --- Headers ----------------------------------------------------------------
# Strict-Transport-Security; the default is below. "off" removes it.
# CALENDAR_HSTS="max-age=63072000; includeSubDomains"
