<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon: the month in ink with its red day over the paper, no insets (the drawing is laid
     out on the 108 grid with its own safe zone). The same month in one colour is the monochrome layer of a
     themed icon (Android 13 and later). Android 7.x uses the PNGs in mipmap-<density>. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
