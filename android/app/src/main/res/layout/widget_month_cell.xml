<?xml version="1.0" encoding="utf-8"?>
<!-- One day on the month's page: its number (in the month, of another month, or today in a circle:
     a view each, so each has its resource colour) and up to three dots in its events' colours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cell_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <TextView
        android:id="@+id/cell_num"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/cell_num_dim"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_dim"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cell_num_today"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/widget_today_circle"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_on_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cell_dots"
        android:layout_width="wrap_content"
        android:layout_height="11dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:textSize="11sp" />
</LinearLayout>
