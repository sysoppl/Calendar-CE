<?xml version="1.0" encoding="utf-8"?>
<!-- A day header of the agenda; today's is in the accent colour, so it has a view of its own. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:paddingStart="@dimen/widget_padding"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/widget_padding"
    android:paddingBottom="2dp"
    tools:ignore="Overdraw">

    <TextView
        android:id="@+id/row_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_weak"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/row_day_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
