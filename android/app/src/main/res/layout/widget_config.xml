<?xml version="1.0" encoding="utf-8"?>
<!-- The settings of a widget (widgets/WidgetConfigActivity.java). Parts that do not apply to the
     widget's kind are hidden in code; the calendars are added in code from the snapshot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/config_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:text="@string/widget_config_title"
        android:textColor="@color/widget_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/config_kind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="2dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/widget_weak"
        android:textSize="15sp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/config_calendars_label"
                style="@style/WidgetConfigSection" />

            <TextView
                android:id="@+id/config_no_calendars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/widget_config_no_calendars"
                android:textColor="@color/widget_weak"
                android:textSize="14sp"
                android:visibility="gone" />

            <RadioGroup
                android:id="@+id/config_calendar_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/config_mode_app"
                    style="@style/WidgetConfigOption" />

                <RadioButton
                    android:id="@+id/config_mode_all"
                    style="@style/WidgetConfigOption" />

                <RadioButton
                    android:id="@+id/config_mode_chosen"
                    style="@style/WidgetConfigOption" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/config_calendar_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:visibility="gone"
                tools:ignore="RtlSymmetry" />

            <TextView
                android:id="@+id/config_days_label"
                style="@style/WidgetConfigSection"
                android:text="@string/widget_config_days" />

            <RadioGroup
                android:id="@+id/config_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/config_tasks"
                style="@style/WidgetConfigOption"
                android:layout_marginTop="16dp"
                android:text="@string/widget_config_tasks"
                app:switchPadding="16dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/config_place"
                style="@style/WidgetConfigOption"
                android:text="@string/widget_config_place"
                app:switchPadding="16dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/config_undated"
                style="@style/WidgetConfigOption"
                android:layout_marginTop="16dp"
                android:text="@string/widget_config_undated"
                app:switchPadding="16dp" />

            <TextView
                style="@style/WidgetConfigSection"
                android:text="@string/widget_config_look" />

            <RadioGroup
                android:id="@+id/config_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/config_theme_system"
                    style="@style/WidgetConfigOption"
                    android:text="@string/widget_config_theme_system" />

                <RadioButton
                    android:id="@+id/config_theme_light"
                    style="@style/WidgetConfigOption"
                    android:text="@string/widget_config_theme_light" />

                <RadioButton
                    android:id="@+id/config_theme_dark"
                    style="@style/WidgetConfigOption"
                    android:text="@string/widget_config_theme_dark" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/config_opacity_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/config_opacity"
                    android:text="@string/widget_config_opacity"
                    android:textColor="@color/widget_weak"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/config_opacity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/config_opacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="40dp" />
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_line" />

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/config_cancel"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:minWidth="88dp"
            android:text="@string/widget_config_cancel"
            android:textAllCaps="false"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/config_save"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/widget_button"
            android:minWidth="104dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:stateListAnimator="@null"
            android:text="@string/widget_config_save"
            android:textAllCaps="false"
            android:textColor="@color/widget_ground"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:ignore="ButtonStyle" />
    </LinearLayout>
</LinearLayout>
