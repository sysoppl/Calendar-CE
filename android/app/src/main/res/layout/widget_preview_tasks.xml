<?xml version="1.0" encoding="utf-8"?>
<!-- How the Tasks widget looks in the widget picker (Android 12 and later), with sample content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_outline"
    android:clipToOutline="true"
    tools:ignore="UseAppTint,UselessLeaf,NestedWeights,DisableBaselineAlignment,TooManyViews,ContentDescription,UseCompoundDrawables"
    tools:targetApi="31">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/widget_padding"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_tasks_title"
                    android:textColor="@color/widget_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_widget_add" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/widget_padding"
            android:layout_marginEnd="@dimen/widget_padding"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingEnd="@dimen/widget_padding">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/widget_check"
                android:tint="#7A4FC2" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/widget_sample_task_1"
                android:textColor="@color/widget_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="@string/widget_today"
                android:textColor="@color/widget_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingEnd="@dimen/widget_padding">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/widget_check"
                android:tint="#1D6CD6" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/widget_sample_task_2"
                android:textColor="@color/widget_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="@string/widget_tomorrow"
                android:textColor="@color/widget_weak"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingEnd="@dimen/widget_padding">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/widget_check"
                android:tint="#1B8037" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/widget_sample_event_3"
                android:textColor="@color/widget_text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
