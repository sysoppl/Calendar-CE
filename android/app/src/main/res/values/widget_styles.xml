<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The widgets' settings screen (widgets/WidgetConfigActivity.java): the widgets' colours, light or
         dark with the system (values-night/widget_colors.xml), controls in the ink of the look. -->
    <style name="WidgetConfigTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/widget_text</item>
        <item name="colorPrimaryDark">@color/widget_ground</item>
        <item name="colorAccent">@color/widget_text</item>
        <item name="colorControlActivated">@color/widget_text</item>
        <item name="colorControlNormal">@color/widget_weak</item>
        <item name="colorControlHighlight">@color/widget_divider</item>
        <item name="android:textColorPrimary">@color/widget_text</item>
        <item name="android:textColorSecondary">@color/widget_weak</item>
        <item name="android:windowBackground">@color/widget_ground</item>
        <item name="android:statusBarColor">@color/widget_ground</item>
        <item name="android:navigationBarColor">@color/widget_ground</item>
    </style>

    <style name="WidgetConfigSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/widget_weak</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetConfigOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
